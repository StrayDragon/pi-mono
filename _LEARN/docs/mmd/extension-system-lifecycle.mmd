%% 扩展系统生命周期
flowchart TD
    subgraph "发现阶段"
        D1[".pi/extensions/"]
        D2["~/.pi/agent/extensions/"]
        D3["settings.extensions[]"]
        D4["CLI --extensions"]
    end

    subgraph "加载阶段"
        JITI["jiti 加载 .ts 模块"]
        FACTORY["执行 ExtensionFactory(pi)"]
        REG_HANDLERS["pi.on() 注册事件"]
        REG_TOOLS["pi.registerTool() 注册工具"]
        REG_CMDS["pi.registerCommand() 注册命令"]
        REG_PROV["pi.registerProvider() 注册供应商"]
        REG_SC["pi.registerShortcut() 注册快捷键"]
    end

    subgraph "运行阶段"
        DISPATCH["ExtensionRunner.dispatch(event)"]
        HANDLERS["遍历所有 handler"]
        MERGE_RESULT["合并结果"]
        ACTIONS["执行 pi.sendMessage/sendUserMessage"]
    end

    subgraph "卸载阶段"
        SHUTDOWN["session_shutdown 事件"]
        INVALIDATE["invalidate() 标记过期"]
        CLEANUP["清理资源"]
    end

    D1 & D2 & D3 & D4 --> JITI --> FACTORY
    FACTORY --> REG_HANDLERS & REG_TOOLS & REG_CMDS & REG_PROV & REG_SC
    REG_HANDLERS --> DISPATCH --> HANDLERS --> MERGE_RESULT
    DISPATCH --> ACTIONS
    SHUTDOWN --> INVALIDATE --> CLEANUP
