%% 会话系统流程
flowchart TD
    subgraph "会话创建"
        CREATE["SessionManager.create()"]
        OPEN["SessionManager.open(path)"]
        CONTINUE["SessionManager.continueRecent()"]
        FORK["SessionManager.forkFrom(entryId)"]
        INMEM["SessionManager.inMemory()"]
    end

    subgraph "JSONL 存储"
        ENCODE["encodeSessionCwd(cwd)"]
        DIR["~/.pi/agent/sessions/&lt;encoded-cwd&gt;/"]
        FILE["xxx.jsonl"]
        APPEND["追加写入条目"]
    end

    subgraph "树结构"
        ROOT["根条目"]
        MSG1["message (user)"]
        MSG2["message (assistant)"]
        TOOL["toolResult"]
        BRANCH["分支点"]
        COMP["compaction"]
        BS["branch_summary"]
    end

    subgraph "上下文构建"
        PATH["提取 root → leaf 路径"]
        CHECK_COMP{"有 compaction?"}
        USE_COMP["摘要 + 后续消息"]
        USE_ALL["所有消息"]
        BUILD["SessionContext<br/>{messages, thinkingLevel, model}"]
    end

    CREATE & OPEN & CONTINUE & FORK --> ENCODE --> DIR --> FILE
    FILE --> APPEND
    ROOT --> MSG1 --> MSG2 --> TOOL
    MSG2 --> BRANCH --> BS
    MSG1 --> COMP
    PATH --> CHECK_COMP
    CHECK_COMP -->|"是"| USE_COMP --> BUILD
    CHECK_COMP -->|"否"| USE_ALL --> BUILD
