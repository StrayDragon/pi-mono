%% 供应商/模型系统生命周期
flowchart TD
    subgraph "模型注册"
        BUILTIN["pi-ai models.generated.ts<br/>内置模型"]
        CUSTOM["~/.pi/agent/models.json<br/>自定义模型"]
        EXT_PROV["扩展 registerProvider()<br/>扩展模型"]
        REGISTRY["ModelRegistry<br/>统一注册表"]
    end

    subgraph "模型选择"
        CLI_MODEL["CLI --model"]
        SESSION_MODEL["会话恢复的模型"]
        SETTINGS_MODEL["settings 默认模型"]
        SCOPED["--models 范围模型"]
        FALLBACK["findInitialModel() 回退"]
        RESOLVE["最终选定模型"]
    end

    subgraph "API Key 解析"
        AUTH_JSON["auth.json (OAuth)"]
        ENV_VAR["环境变量"]
        MODELS_KEY["models.json 配置"]
        RUNTIME["getApiKey() 动态"]
        KEY["最终 API Key"]
    end

    BUILTIN & CUSTOM & EXT_PROV --> REGISTRY
    CLI_MODEL --> RESOLVE
    SESSION_MODEL --> RESOLVE
    SETTINGS_MODEL --> RESOLVE
    SCOPED --> RESOLVE
    FALLBACK --> RESOLVE
    AUTH_JSON --> KEY
    ENV_VAR --> KEY
    MODELS_KEY --> KEY
    RUNTIME --> KEY
