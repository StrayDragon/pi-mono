
flowchart TD
    subgraph Discovery["Provider Discovery"]
        A[Load Built-in Providers] --> B[Load Custom Providers from models.json]
        B --> C[Load Extension Providers]
        C --> D[Register with ApiProviderRegistry]
    end

    subgraph Registration["Provider Registration"]
        D --> E{Provider Type?}
        E -->|Built-in| F[Uses Lazy Loading]
        E -->|Custom| G[Immediate Registration]
        E -->|Extension| H[Dynamic Registration]
        F --> I[ApiProviderRegistry]
        G --> I
        H --> I
    end

    subgraph ModelResolution["Model Resolution"]
        I --> J[ModelRegistry.getAll]
        J --> K{Has Auth?}
        K -->|Yes| L[ModelRegistry.getAvailable]
        K -->|No| M[Exclude from Available]
        L --> N[Merge Built-in + Custom + Extension]
        M --> N
    end

    subgraph RequestExecution["Request Execution"]
        N --> O[Agent Requests Model]
        O --> P[ModelRegistry.getApiKeyAndHeaders]
        P --> Q{Auth Available?}
        Q -->|No| R[Return Error]
        Q -->|Yes| S[Resolve API Key from Config]
        S --> T[Get ApiProvider from Registry]
        T --> U[Call provider.streamSimple]
        U --> V{Lazy Load?}
        V -->|Yes| W[Load Provider Module]
        V -->|No| X[Execute Stream]
        W --> X
        X --> Y[Return AssistantMessageEventStream]
    end

    subgraph OAuthFlow["OAuth Flow"]
        H --> Z{Provider has OAuth?}
        Z -->|Yes| AA[Register OAuth Provider]
        AA --> AB[Supports /login Command]
        AB --> AC[Token Refresh on Request]
        AC --> AD[Modify Models if Needed]
        Z -->|No| AE[Standard Auth Only]
    end

    RequestExecution --> OAuthFlow

    style A fill:#e1f5ff
    style I fill:#fff4e6
    style N fill:#f3e5f5
    style U fill:#e8f5e9
    style AA fill:#ffebee
    style R fill:#ffcccc
