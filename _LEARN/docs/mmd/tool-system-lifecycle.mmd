%% 工具系统生命周期
flowchart TD
    subgraph "工具注册"
        BUILTIN["内置工具<br/>createCodingTools()"]
        EXT_TOOL["扩展工具<br/>registerTool()"]
        MERGE["合并到 Agent.tools"]
    end

    subgraph "工具执行"
        TC["LLM 发出 toolCall"]
        FIND["查找工具定义"]
        PREP["prepareArguments()"]
        VALIDATE["validateToolArguments()<br/>TypeBox 校验"]
        BEFORE["beforeToolCall() 钩子"]
        EXEC["tool.execute()"]
        UPDATE["onUpdate() 部分结果"]
        AFTER["afterToolCall() 钩子"]
        RESULT["ToolResultMessage"]
    end

    subgraph "结果处理"
        EMIT["emit(tool_execution_end)"]
        RENDER["renderResult() UI 渲染"]
        PERSIST["写入 JSONL"]
        INJECT["注入 Agent 上下文"]
    end

    BUILTIN --> MERGE
    EXT_TOOL --> MERGE
    MERGE --> TC --> FIND --> PREP --> VALIDATE --> BEFORE
    BEFORE -->|"block"| BLOCK_RESULT["错误结果"]
    BEFORE -->|"allow"| EXEC
    EXEC --> UPDATE
    EXEC --> AFTER --> RESULT
    RESULT --> EMIT --> RENDER
    RESULT --> PERSIST
    RESULT --> INJECT
