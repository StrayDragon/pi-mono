%% 上下文压缩系统生命周期
flowchart TD
    subgraph "触发条件"
        AUTO["自动触发<br/>上下文使用 > 阈值"]
        MANUAL["手动触发<br/>/compact 命令"]
        EXT_TRIGGER["扩展触发<br/>ctx.compact()"]
    end

    subgraph "压缩流程"
        PREPARE["prepareCompaction()<br/>计算保留范围"]
        SHOULD["shouldCompact()<br/>是否需要压缩"]
        BEFORE_HOOK["session_before_compact<br/>扩展可取消/替换"]
        LLM_SUMMARIZE["LLM 生成摘要"]
        ENTRY["创建 CompactionEntry"]
    end

    subgraph "结果"
        TREE_UPDATE["会话树插入压缩节点"]
        CONTEXT_REBUILD["重建上下文<br/>摘要 + 保留消息"]
        AFTER_HOOK["session_compact 通知"]
    end

    AUTO & MANUAL & EXT_TRIGGER --> PREPARE --> SHOULD
    SHOULD -->|"不需要"| SKIP["跳过"]
    SHOULD -->|"需要"| BEFORE_HOOK
    BEFORE_HOOK -->|"取消"| SKIP
    BEFORE_HOOK -->|"继续"| LLM_SUMMARIZE --> ENTRY
    ENTRY --> TREE_UPDATE --> CONTEXT_REBUILD --> AFTER_HOOK
