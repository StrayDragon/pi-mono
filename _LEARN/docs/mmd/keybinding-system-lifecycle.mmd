%% 快捷键系统生命周期
flowchart TD
    subgraph "定义层"
        TUI_KB["TUI_KEYBINDINGS<br/>tui.editor.* / tui.input.* / tui.select.*"]
        APP_KB["KEYBINDINGS<br/>app.interrupt / app.exit / app.model.* / ..."]
        DECL_MERGE["声明合并<br/>interface Keybindings extends AppKeybindings"]
    end

    subgraph "管理层"
        KBM["KeybindingsManager.create()"]
        USER_OVERRIDE["~/.pi/agent/keybindings.json"]
        CONFLICT["冲突检测"]
    end

    subgraph "使用层"
        MATCHES["keybindings.matches(data, 'app.interrupt')"]
        CUSTOM_ED["CustomEditor.handleInput()"]
        SELECT_LIST["SelectList.handleInput()"]
        EXT_SC["扩展 registerShortcut()"]
    end

    TUI_KB --> APP_KB --> DECL_MERGE --> KBM
    USER_OVERRIDE --> KBM --> CONFLICT
    KBM --> MATCHES
    MATCHES --> CUSTOM_ED & SELECT_LIST & EXT_SC
